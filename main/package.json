{
  "name": "nexus-crm",
  "version": "0.3.2",
  "description": "NEXUS - Personal CRM with Telegram Bot + Obsidian Vault",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "newsflow": "ts-node src/newsflow/index.ts",
    "restart": "pm2 restart nexus && echo 'Bot restarted!'",
    "rebuild": "npm run build && pm2 restart nexus && echo 'Built and restarted!'",
    "stop": "pm2 stop nexus && echo 'Bot stopped!'",
    "logs": "pm2 logs nexus --lines 50"
  },
  "license": "PRIVATE",
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "chokidar": "^5.0.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "https-proxy-agent": "^7.0.6",
    "openai": "^6.21.0",
    "rss-parser": "^3.13.0",
    "telegraf": "^4.16.3",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "ts-node": "^10.9.2"
  }
}
