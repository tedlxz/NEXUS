# Telegram Bot Token - 每个用户需要从 @BotFather 获取自己的 Token
# 运行 install.sh 时会提示输入
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# User IDs (comma-separated) - get from @userinfobot
AUTHORIZED_USER_IDS=6573965713

# Default Obsidian Vault path
VAULT_PATH_DEFAULT=~/Library/Mobile\ Documents/iCloud~md~obsidian/Documents/Nexus-Vault
# Per-user vault paths (format: VAULT_PATH_<USER_ID>=<path>)
# Example: VAULT_PATH_5599064334=~/Library/Mobile\ Documents/iCloud~md~obsidian/Documents/Dilong-Vault
TELEGRAM_PROXY=  # Optional: http://127.0.0.1:7890 (if needed in China)

# MiniMax AI
MINIMAX_API_KEY=your_minimax_api_key_here

# Web Dashboard (optional)
WEB_PASSWORD=your_secret_password
PORT=3000

# Newsflow Configuration
NEWSFLOW_CHAT_ID=your_chat_id_here
FINNHUB_API_KEY=  # Optional: for US stock news
AKSHARE_ENABLED=true
AKSHARE_PYTHON_PATH=python3
