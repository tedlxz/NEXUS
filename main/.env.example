# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
AUTHORIZED_USER_IDS=your_chat_id_here
TELEGRAM_PROXY=  # Optional: http://127.0.0.1:7890 (if needed in China)

# MiniMax AI
MINIMAX_API_KEY=your_minimax_api_key_here

# Obsidian Vault
# Example: ~/Library/Mobile Documents/iCloud~md~obsidian/Documents/Nexus-Vault
VAULT_PATH=~/Library/Mobile\ Documents/iCloud~md~obsidian/Documents/Nexus-Vault

# Web Dashboard (optional)
WEB_PASSWORD=your_secret_password
PORT=3000

# Newsflow Configuration
NEWSFLOW_CHAT_ID=your_chat_id_here
FINNHUB_API_KEY=  # Optional: for US stock news
AKSHARE_ENABLED=true
AKSHARE_PYTHON_PATH=python3
